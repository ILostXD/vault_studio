PORT=8080

DATA_DIR=./data

# JWT secret for signing access tokens (REQUIRED)
JWT_SECRET=

# Signed URL secret for media access (REQUIRED)
SIGNED_URL_SECRET=

# Pepper for hashing refresh/invite/reset tokens
TOKEN_PEPPER=

# Auth settings
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SIGNED_URL_TTL=5m

# Set to "disabled" when running the Go server without the analysis sidecar.
# Docker Compose configures this automatically.
AUDIO_ANALYSIS_URL=http://127.0.0.1:8001

# Cookie settings
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
# COOKIE_DOMAIN=example.com

# Comma-separated list of allowed CORS origins
# CORS_ALLOWED_ORIGINS=https://vault.example.com

# Optional Too Lost integration. PUBLIC_BASE_URL must be public HTTPS so Too Lost can return OAuth callbacks.
# TOOLOST_CLIENT_ID=
# TOOLOST_CLIENT_SECRET=
# TOOLOST_ENVIRONMENT=sandbox
# PUBLIC_BASE_URL=https://vault.example.com
# Optional advanced override. By default Vault derives a stable provider key
# from JWT_SECRET. Do not rotate this after connecting provider accounts.
# PROVIDER_TOKEN_ENCRYPTION_KEY=

# Optional in-app updater. Normally supplied by docker-compose.updates.yml.
# VAULT_UPDATE_URL=http://vault-updater:8080/v1/update
# VAULT_UPDATE_TOKEN=
