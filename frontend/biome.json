{
	"$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.js",
			"!**/src/routeTree.gen.ts",
			"!**/android",
			"!**/src/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"useMediaCaption": "off",
				"noLabelWithoutControl": {
					"level": "error",
					"options": { "inputComponents": ["Input", "Textarea"] }
				},
				"noStaticElementInteractions": "warn",
				"useKeyWithClickEvents": "warn",
				"useSemanticElements": "warn",
				"noAutofocus": "warn",
				"noAriaHiddenOnFocusable": "warn"
			},
			"correctness": {
				"useExhaustiveDependencies": "warn",
				"useUniqueElementIds": "warn"
			},
			"suspicious": {
				"noArrayIndexKey": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
